{
  "search.exclude": {
    "**/thinkio-archive/**": true,
    "**/thinkio_new_session_workspace/**": true,
    "**/archive/**": true,
    "**/old-versions/**": true,
    "**/candidate-extraction-piles/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },
  "files.watcherExclude": {
    "**/thinkio-archive/**": true,
    "**/thinkio_new_session_workspace/**": true,
    "**/archive/**": true,
    "**/old-versions/**": true,
    "**/candidate-extraction-piles/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\.tools\\cue;${env:PATH}"
  },
  "kanban-markdown.featuresDirectory": ".devtool/features",
  "kanban-markdown.defaultStatus": "candidate",
  "kanban-markdown.defaultPriority": "medium",
  "kanban-markdown.compactMode": true,
  "kanban-markdown.markdownEditorMode": true,
  "kanban-markdown.showAssignee": false,
  "kanban-markdown.showDueDate": false,
  "kanban-markdown.showBuildWithAI": false,
  "kanban-markdown.columns": [
    { "id": "idea", "name": "Idea", "color": "#64748b" },
    { "id": "candidate", "name": "Candidate", "color": "#2563eb" },
    { "id": "accepted", "name": "Accepted", "color": "#0891b2" },
    { "id": "frozen", "name": "Frozen", "color": "#7c3aed" },
    { "id": "executable", "name": "Executable", "color": "#d97706" },
    { "id": "done", "name": "Done", "color": "#16a34a" },
    { "id": "rejected", "name": "Rejected", "color": "#dc2626" },
    { "id": "archived", "name": "Archived", "color": "#475569" }
  ],
  "jsonFlow.graph.layoutOrientation": "LR"
}
