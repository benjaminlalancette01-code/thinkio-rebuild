    "views": {
      "kanbanData": {
        "file": "views/kanban.json",
        "status": "existing-data",
        "note": "This generated task-board data is canonical only as a projection from tasks/*.json."
      },
      "mindmapData": {
        "file": "views/mindmap.json",
        "status": "existing-data",
        "note": "Task/concept mindmap data, not a full runtime flow map."
      },
      "runtimeFlowData": {
        "file": "views/thinkio-runtime-flow.json",
        "status": "visual-support",
        "note": "This file is shaped for JSON Flow."
      },
      "kanbanMarkdownCards": {
        "file": ".devtool/features/*.md",
        "status": "visual-mirror",
        "note": "Kanban Markdown cards are documented as read-only visual mirrors in docs/kanban-markdown-sync-boundary.md."
      }
    }
  },
  "endToEndFlows": {
    "taskValidation": [
      "tasks/*.json",
      "runtime/cue-validator.ts",
      "schemas/task.schema.cue",
      "cue vet",
      "CueValidationResult[]",
      "summarizeCueValidationResults",
      "runtime/validate-schemas.ts"
    ],
    "taskPromotion": [
      "GovernedTask",
      "kernel/state-machine.ts",
      "kernel/gate.ts",
      "requiredEvidence[]",
      "status transition allowed",
      "checkpoint required"
    ],
    "taskExecutionPreview": [
      "GovernedTask",
      "runtime/local-dev-runtime.ts",
      "runtime/command-registry.ts",
      "state/approvals.json",
      "kernel/context-router.ts",
      "kernel/checkpoint.ts",
      "ContextPacket + CheckpointRecord"
    ],
    "mutationPlanning": [
      "GovernedTask",
      "runtime/local-dev-runtime.ts",
      "ApprovalRecord[] or state/approvals.json",
      "kernel/mutation-transaction.ts",
      "ArtifactRecord[] + CheckpointRecord[]",
      "MutationTransactionRecord + blockers"
    ],
    "mutationApplication": [
      "MutationTransactionRecord",
      "runtime/local-dev-runtime.ts approval boundary",
      "runtime/mutation-applier.ts",
      "current task JSON + ledger + checkpoints",
      "temp-file writes",
      "updated task + ledger + checkpoint + rollback metadata"
    ],
    "taskRunPreparation": [
      "GovernedTask",
      "runtime/task-runner.ts",
      "kernel/gate.ts",
      "kernel/execution-window.ts",
      "runtime/local-dev-runtime.ts approval blockers",
      "kernel/context-router.ts",
      "canExecute + blockedReasons + contextPacket"
    ],
    "artifactEvidence": [
      "task output path",
      "kernel/ledger.ts",
      "ArtifactRecord",
      "state/ledger.json",
      "schemas/artifact.schema.cue"
    ],
    "visualSupport": [
      "tasks/*.json",
      "runtime/update-views.ts",
      "Kanban Markdown cards in .devtool/features",
      "views/kanban.json",
      "views/mindmap.json",
      "views/dashboard.json",
      "views/thinkio-runtime-flow.json",
      "VS Code Kanban Markdown + JSON Flow"
    ]
  },
