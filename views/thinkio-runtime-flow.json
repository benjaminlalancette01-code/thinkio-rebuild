{
  "title": "ThinkIO Kernel and Runtime Flow",
  "purpose": "Visual support for JSON Flow. This file maps the current ThinkIO rebuild so missing kernel/runtime pieces are easy to inspect.",
  "sourceOfTruth": {
    "tasks": "tasks/*.json",
    "schemas": "schemas/*.cue",
    "kernel": "kernel/*.ts",
    "runtime": "runtime/*.ts",
    "state": "state/*.json"
  },
  "openInVSCode": {
    "extension": "JSON Flow - Graph Explorer",
    "command": "JSON Flow: Show Preview",
    "file": "views/thinkio-runtime-flow.json",
    "useSearchTokens": [
      "key:missing",
      "value:planned",
      "value:implemented",
      "value:TASK-006",
      "path:/system/kernel"
    ]
  },
  "system": {
    "taskModel": {
      "kind": "governed-task",
      "schema": "schemas/task.schema.cue",
      "typeDefinition": "kernel/types.ts#GovernedTask",
      "fields": [
        "id",
        "title",
        "mode",
        "status",
        "authority",
        "dependencies",
        "allowedContext",
        "blockedContext",
        "requiredEvidence",
        "promotionRule",
        "checkpointRequired"
      ],
      "statusVocabulary": [
        "idea",
        "candidate",
        "accepted",
        "frozen",
        "executable",
        "done",
        "rejected",
        "archived"
      ],
      "modeVocabulary": [
        "brainstorm",
        "plan",
        "build",
        "review",
        "freeze",
        "execute"
      ],
      "authorityVocabulary": [
        "idea",
        "candidate",
        "accepted",
        "frozen",
        "executable",
        "final",
        "rejected",
        "archived"
      ]
    },
    "kernel": {
      "stateMachine": {
        "file": "kernel/state-machine.ts",
        "status": "implemented",
        "responsibility": "Defines allowed task status transitions, authority transitions, and authority/status compatibility.",
        "exports": [
          "isTransitionAllowed",
          "assertTransitionAllowed",
          "allowedNextStatuses",
          "isAuthorityTransitionAllowed",
          "assertAuthorityTransitionAllowed",
          "allowedNextAuthorities",
          "isAuthorityCompatibleWithStatus"
        ],
        "flow": [
          "idea -> candidate",
          "candidate -> accepted",
          "candidate -> rejected",
          "accepted -> frozen",
          "frozen -> executable",
          "executable -> done",
          "done -> archived",
          "rejected -> archived"
        ],
        "authorityFlow": [
          "idea -> candidate",
          "candidate -> accepted",
          "candidate -> rejected",
          "accepted -> frozen",
          "frozen -> executable",
          "executable -> final",
          "final -> archived",
          "rejected -> archived"
        ],
        "coveredByTasks": [
          "TASK-001",
          "TASK-025"
        ]
      },
      "gate": {
        "file": "kernel/gate.ts",
        "status": "implemented",
        "responsibility": "Checks promotion evidence and executable authority.",
        "exports": [
          "canPromoteTask",
          "canExecuteTask",
          "explainBlockedExecution"
        ],
        "rules": [
          "Promotion requires promotionRule all-required-evidence-present.",
          "All requiredEvidence entries must be present.",
          "Execution requires status executable and authority executable.",
          "Archive context is blocked by default."
        ],
        "coveredByTasks": [
          "TASK-001",
          "TASK-003",
          "TASK-004"
        ]
      },
      "contextRouter": {
        "file": "kernel/context-router.ts",
        "status": "implemented",
        "responsibility": "Builds context packets from allowed and blocked task context, then applies mode-aware source rules.",
        "exports": [
          "buildContextPacket",
          "buildModeAwareContextPacket",
          "defaultSourceRulesForTask",
          "inferAuthorityForPath"
        ],
        "rules": [
          "Archive paths are excluded even if allowedContext includes them.",
          "blockedContext and archive-derived exclusions are de-duplicated.",
          "Mode-aware packets filter files by task mode.",
          "Context sources receive inferred authority levels."
        ],
        "coveredByTasks": [
          "TASK-006"
        ]
      },
      "deferred": {
        "file": "kernel/deferred.ts",
        "status": "implemented",
        "responsibility": "Models deferred work with reason, actor, resume timing, required evidence, and resume checks.",
        "schema": "schemas/deferred.schema.cue",
        "stateFile": "state/deferred.json",
        "exports": [
          "createDeferredItem",
          "createDeferredItemForTask",
          "canResumeDeferredItem",
          "explainDeferredBlockers"
        ],
        "coveredByTasks": [
          "TASK-003"
        ]
      },
      "executionWindow": {
        "file": "kernel/execution-window.ts",
        "status": "implemented",
        "responsibility": "Blocks task execution outside the valid time window or wrong task binding.",
        "schema": "schemas/execution-window.schema.cue",
        "stateFile": "state/execution-windows.json",
        "exports": [
          "createExecutionWindow",
          "isExecutionWindowOpen",
          "canExecuteWithinWindow",
          "explainExecutionWindowBlockers"
        ],
        "coveredByTasks": [
          "TASK-004"
        ]
      },
      "ledger": {
        "file": "kernel/ledger.ts",
        "status": "implemented",
        "responsibility": "Creates and stores artifact records, preserving optional hash and dependency metadata.",
        "schema": "schemas/artifact.schema.cue",
        "stateFile": "state/ledger.json",
        "exports": [
          "createArtifactRecord",
          "addLedgerEntry",
          "findArtifactById"
        ],
        "coveredByTasks": [
          "TASK-005",
          "TASK-021"
        ]
      },
      "artifactChain": {
        "file": "kernel/artifact-chain.ts",
        "status": "implemented",
        "responsibility": "Builds artifact chain manifests, checks dependency references, enforces task scope, and surfaces stale artifact hashes.",
        "schema": "schemas/artifact.schema.cue#ArtifactChainManifest",
        "stateFile": "state/artifact-chains.json",
        "exports": [
          "createArtifactChainManifest",
          "findStaleArtifactIds",
          "validateArtifactChain"
        ],
        "coveredByTasks": [
          "TASK-005",
          "TASK-022"
        ]
      },
      "checkpoint": {
        "file": "kernel/checkpoint.ts",
        "status": "implemented",
        "responsibility": "Creates and validates checkpoint records and checkpoint-bound handoff records.",
        "schema": "schemas/checkpoint.schema.cue",
        "stateFile": "state/checkpoints.json",
        "exports": [
          "createCheckpoint",
          "validateCheckpoint",
          "createHandoff",
          "validateHandoff"
        ],
        "coveredByTasks": [
          "TASK-007"
        ]
      },
      "decomposition": {
        "file": "kernel/decomposition.ts",
        "status": "implemented",
        "responsibility": "Preserves parent dependencies, required evidence, checkpoints, and reconstruction paths across governed child tasks.",
        "schema": "schemas/decomposition.schema.cue",
        "exports": [
          "createDecompositionRecord",
          "validateDecompositionRecord",
          "explainDecompositionBlockers"
        ],
        "coveredByTasks": [
          "TASK-010"
        ]
      },
      "replayValidation": {
        "file": "kernel/replay-validation.ts",
        "status": "implemented",
        "responsibility": "Checks whether reconstruction can be replayed from required state files, checkpoints, artifacts, artifact chains, and graph nodes.",
        "schema": "schemas/replay-validation.schema.cue",
        "exports": [
          "createReplayValidationManifest",
          "validateReplayReadiness",
          "explainReplayReadinessBlockers"
        ],
        "coveredByTasks": [
          "TASK-011"
        ]
      },
      "mutationTransaction": {
        "file": "kernel/mutation-transaction.ts",
        "status": "implemented",
        "responsibility": "Plans evidence-gated status and authority changes with ledger, checkpoint, rollback effects, and explicit authority transition validation.",
        "schema": "schemas/mutation-transaction.schema.cue",
        "exports": [
          "createMutationTransactionRecord",
          "explainMutationTransactionBlockers",
          "validateMutationTransaction"
        ],
        "coveredByTasks": [
          "TASK-012",
          "TASK-018",
          "TASK-025"
        ]
      }
    },
    "runtime": {
      "commandRegistry": {
        "file": "runtime/command-registry.ts",
        "status": "implemented",
        "responsibility": "Allow-lists local runtime actions and blocks risky runtime actions.",
        "allowedActions": [
          "validate-json-task-files",
          "validate-cue-schemas",
          "validate-transitions",
          "apply-mutation-transaction",
          "plan-mutation-transaction",
          "update-views",
          "build-context-packet",
          "run-tests",
          "write-checkpoint"
        ],
        "implementedActions": [
          "validate-json-task-files",
          "validate-cue-schemas",
          "validate-transitions",
          "apply-mutation-transaction",
          "plan-mutation-transaction",
          "update-views",
          "build-context-packet",
          "run-tests",
          "write-checkpoint"
        ],
        "reservedActions": [],
        "blockedActions": [
          "destructive-shell-commands",
          "external-api-calls",
          "plugin-marketplace-release",
          "autonomous-file-promotion-from-archive",
          "activation-of-old-runtime-files"
        ]
      },
      "cueValidator": {
        "file": "runtime/cue-validator.ts",
        "status": "implemented",
        "responsibility": "Discovers governed task JSON and canonical state JSON files, then validates them with CUE.",
        "entryPoints": [
          "discoverTaskCueValidationTargets",
          "discoverWorkspaceCueValidationTargets",
          "validateCueTargets",
          "validateDiscoveredTaskSchemas",
          "validateWorkspaceCueSchemas",
          "summarizeCueValidationResults"
        ],
        "externalCommand": "cue vet <json> <schema.cue> -d <definition>",
        "modes": [
          "strict",
          "soft"
        ],
        "coveredByTasks": [
          "TASK-002",
          "TASK-019"
        ]
      },
      "localDevRuntime": {
        "file": "runtime/local-dev-runtime.ts",
        "status": "implemented",
        "responsibility": "Gates local runtime actions, applies approval boundaries, loads approval state, validates schemas, updates views, plans mutation transactions, applies approved mutation transactions, validates JSON task files, validates transition state, and runs local tests.",
        "flows": [
          "buildTaskRuntimePreview -> assert build-context-packet -> assert write-checkpoint -> buildContextPacket + createCheckpoint",
          "buildTaskRuntimePreviewFromState -> read state/approvals.json -> buildTaskRuntimePreview",
          "planMutationTransaction -> assert plan-mutation-transaction -> approval boundary -> kernel mutation transaction validation",
          "planMutationTransactionFromState -> read state/approvals.json -> planMutationTransaction",
          "applyMutationTransaction -> assert apply-mutation-transaction -> approval boundary -> mutation applier guarded writes",
          "validateJsonTaskFiles -> parse governed task JSON files before schema validation",
          "validateTaskTransitionStates -> check status/authority compatibility",
          "runLocalTests -> run or inject npm test command execution",
          "validateWorkspaceSchemas -> assert validate-cue-schemas -> discover or validate task and state CUE targets",
          "updateWorkspaceViews -> assert update-views -> regenerate visual projections"
        ],
        "approvalRequiredActions": [
          "apply-mutation-transaction",
          "plan-mutation-transaction",
          "write-checkpoint"
        ],
        "coveredByTasks": [
          "TASK-013",
          "TASK-018",
          "TASK-020",
          "TASK-026",
          "TASK-027"
        ]
      },
      "mutationApplier": {
        "file": "runtime/mutation-applier.ts",
        "status": "implemented-guarded",
        "responsibility": "Applies validated mutation transactions to task, ledger, checkpoint, and rollback files through guarded temp-file writes.",
        "entryPoints": [
          "applyMutationTransactionToWorkspace"
        ],
        "writes": [
          "task JSON status and authority",
          "state/ledger.json artifact effects",
          "state/checkpoints.json checkpoint effects",
          "state/mutation-rollbacks.json rollback metadata"
        ],
        "coveredByTasks": [
          "TASK-026"
        ]
      },
      "taskRunner": {
        "file": "runtime/task-runner.ts",
        "status": "implemented-guarded",
        "responsibility": "Prepares a task run by checking executable status, optional execution windows, optional approval boundaries, and context packet construction.",
        "outputs": [
          "taskId",
          "canExecute",
          "blockedReasons",
          "contextPacket"
        ],
        "optionalInputs": [
          "ExecutionWindow",
          "ApprovalRecord[]",
          "ApprovalRequiredLocalDevAction",
          "Date"
        ],
        "coveredByTasks": [
          "TASK-023"
        ]
      },
      "fileWatcher": {
        "file": "runtime/file-watcher.ts",
        "status": "implemented-basic",
        "responsibility": "Defines path exclusions for watcher-like behavior.",
        "excludedAreas": [
          "thinkio-archive",
          "archive",
          "old-versions",
          "candidate-extraction-piles",
          "node_modules",
          "dist"
        ]
      },
      "validateSchemasCli": {
        "file": "runtime/validate-schemas.ts",
        "status": "implemented",
        "responsibility": "CLI wrapper for workspace schema validation.",
        "npmScripts": [
          "validate:cue",
          "validate:cue:soft",
          "check"
        ]
      },
      "updateViewsCli": {
        "file": "runtime/update-views.ts",
        "status": "implemented",
        "responsibility": "Regenerates visual projection files from governed task JSON, project graph data, and deferred state.",
        "entryPoints": [
          "updateViewFiles"
        ],
        "flows": [
          "tasks/*.json + state/project.graph.json + state/deferred.json -> buildKanbanView + buildMindmapView + buildDashboardView",
          "buildKanbanView -> views/kanban.json",
          "buildMindmapView -> views/mindmap.json",
          "buildDashboardView -> views/dashboard.json"
        ],
        "npmScripts": [
          "update:views"
        ],
        "coveredByTasks": [
          "TASK-008"
        ]
      }
    },
    "state": {
      "approvals": {
        "file": "state/approvals.json",
